PORT=8080
MONGODB_URI="mongodb://localhost:27017/uptimewatch"

# Auth: Clerk JWTs are verified against the issuer's JWKS.
# Allowlist of trusted token issuers — your Clerk instance URL
# (e.g. https://your-app.clerk.accounts.dev). Comma-separate for multiple.
# If unset, the issuer is derived from CLERK_PUBLISHABLE_KEY instead.
# With neither set, the API rejects every request.
CLERK_ISSUER="https://your-app.clerk.accounts.dev"
# CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Google PageSpeed Insights API key (server-side only).
# PSI_API_KEY=

RESEND_API_KEY=yourresendapikey
EMAIL_NOTIFICATIONS_ENABLED=false

# Email "from" address for alerts. In production this must be an address
# on a domain verified in Resend.
# If you keep the default onboarding sender, Resend only allows sending to
# your own account email in testing mode.
# EMAIL_FROM="UptimeWatch <noreply@yourdomain.com>"

# Production frontend URL(s) allowed by CORS (comma-separated). localhost is always allowed.
# FRONTEND_URL="https://yourapp.com"

# Background jobs (monitoring, alerts, SSL) run inside the API by default.
# To run them in a separate process (`bun run worker`), set this to false on
# API instances. Jobs are lease-guarded, so multiple instances are safe.
# RUN_SCHEDULERS=true
# MONITOR_CONCURRENCY=25
# MAX_MONITORS_PER_USER=50
# RATE_LIMIT_PER_MINUTE=120
# TRUST_PROXY=1
