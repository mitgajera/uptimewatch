# Copy to .env.local and fill in.

# Base URL of the API (no trailing slash), e.g. http://localhost:8080
NEXT_PUBLIC_API_BACKEND_URL=http://localhost:8080

# Clerk keys from your Clerk dashboard (API keys page).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Optional: Clerk JWT template name to use for API tokens.
# NEXT_PUBLIC_CLERK_JWT_TEMPLATE=
